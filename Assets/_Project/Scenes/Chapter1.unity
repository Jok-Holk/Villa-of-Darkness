--- !u!114 &174646069
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 174646068}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6895885b029c35478f5d931d22350ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: BietThuBongToi.Runtime::MusicBoxInteractable
  _interactLabel: "H\u1ED9p \xE2m nh\u1EA1c \u0111\u1ED3ng"
  _startupSfx01: {fileID: 8300000, guid: bdecdb100e48b3f4a911f9bfad935a4e, type: 3}
  _startupSfx02: {fileID: 8300000, guid: 357c2c7675e3ca347af6675f902513f3, type: 3}
  _delayBetweenStartupSfx: 1.2
  _delayBeforeTape: 1
  _tapeClip: {fileID: 8300000, guid: 3a556775b03f92c4f936e9cd2391aec8, type: 3}
  _captions:
  - startTime: 0
    text: "Ng\xE0y 3 th\xE1ng 9, 1963. Con Linh n\xF3 n\xF3i n\xF3 th\u1EA5y m\u1EB7t
      ng\u01B0\u1EDDi trong gi\u1EBFng n\xEAn t\xF4i \u0111\xE3 \u0111i b\u1ECBt
      gi\u1EBFng l\u1EA1i b\u1EB1ng v\u1EA3i \u0111\u1ECF. Nh\u01B0ng s\xE1ng h\xF4m
      sau t\u1EA5m v\u1EA3i li\u1EC1n bi\u1EBFn m\u1EA5t."
  - startTime: 16.8
    text: "T\xF4i b\u1EAFt \u0111\u1EA7u d\u1EA1y con Linh \u0111\u1EEBng bao gi\u1EDD
      nh\xECn th\u1EB3ng v\xE0o b\u1EA5t k\u1EF3 m\u1EB7t n\u01B0\u1EDBc hay m\u1EB7t
      g\u01B0\u01A1ng n\xE0o qu\xE1 l\xE2u. Con b\xE9 c\xF2n qu\xE1 nh\u1ECF, kh\xF4ng
      hi\u1EC3u v\xEC sao t\xF4i nghi\xEAm kh\u1EAFc v\u1EADy, ch\u1EC9 bi\u1EBFt
      v\xE2ng l\u1EDDi."
  - startTime: 33
    text: "C\xF3 \u0111\xEAm t\xF4i gi\u1EADt m\xECnh t\u1EC9nh gi\u1EA5c, th\u1EA5y
      ch\xEDnh m\xECnh \u0111ang \u0111\u1EE9ng \u1EDF tr\u01B0\u1EDBc c\u1EEDa ph\xF2ng
      con Linh, tay c\u1EA7m ng\u1ECDn n\u1EBFn, kh\xF4ng nh\u1EDB b\u1EA3n th\xE2n
      m\xECnh \u0111\xE3 d\u1EADy t\u1EEB l\xFAc n\xE0o. T\xF4i s\u1EE3 nh\u1EA5t
      kh\xF4ng ph\u1EA3i l\xE0 th\u1EE9 con Linh \u0111\xE3 t\u1EEBng nh\xECn th\u1EA5y
      \u2014 m\xE0 l\xE0 t\xF4i s\u1EE3 CH\xCDNH B\u1EA2N TH\xC2N M\xCCNH."
  - startTime: 53.1
    text: "T\xF4i bi\u1EBFt... t\xF4i bi\u1EBFt chuy\u1EC7n \xF4ng \u1EA5y l\xE0m
      v\u1EDBi \u0111\xE1m phu h\u1ED3i n\u0103m ngo\xE1i. T\xF4i kh\xF4ng n\xF3i
      g\xEC c\u1EA3. Nh\xE0 c\u1EEDa \u0111\u1EA7y \u0111\u1EE7, con c\xE1i \u1EA5m
      no, t\xF4i... t\xF4i ch\u1ECDn im l\u1EB7ng. \xD4ng nh\xE0 t\xF4i kh\xF4ng
      tin t\xF4i khi t\xF4i n\xF3i nh\xE0 m\xECnh c\xF3 chuy\u1EC7n ch\u1EB3ng l\xE0nh
      \u2014 nh\u01B0ng t\xF4i \u0111\xE2u c\xF3 t\u01B0 c\xE1ch g\xEC m\xE0 tr\xE1ch
      \xF4ng \u1EA5y kh\xF4ng tin. Gi\u1EDD t\xF4i m\u1EDBi hi\u1EC3u, c\xE1i gi\xE1
      ph\u1EA3i tr\u1EA3 \u0111\xE2u ch\u1EC9 c\xF3 m\u1ED9t m\xECnh t\xF4i."
  - startTime: 90.8
    text: "N\u1EBFu \xF4ng t\xECm th\u1EA5y cu\u1ED1n b\u0103ng n\xE0y... ngh\u0129a
      l\xE0 t\xF4i \u0111\xE3 kh\xF4ng c\xF2n \u0111\u1EE7 s\u1EE9c gi\u1EEF n\xF3
      trong ng\u01B0\u1EDDi n\u1EEFa. Xin \xF4ng \u0111\u1EEBng \u0111i t\xECm t\xF4i.
      Xin \xF4ng ch\u0103m s\xF3c hai \u0111\u1EE9a nh\u1ECF thay t\xF4i."
  _curiousThought: {fileID: 11400000, guid: 3b7df82e27f8c5643a9b820cda78bb13, type: 2}
  _doorThuPhongSalon: {fileID: 1785791471}
  _pickupItemAfterListening: {fileID: 174646070}
