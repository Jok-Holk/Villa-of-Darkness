--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff4459042ab88464388416038b51768c, type: 3}
  m_Name: DialogueAsset_Ch1_Intro
  m_EditorClassIdentifier: BietThuBongToi.Runtime::DialogueAsset
  lines:
  - speakerName: Minh Khoa
    text: "Cu\u1ED1i c\xF9ng c\u0169ng \u0111\u1EBFn n\u01A1i r\u1ED3i. \u0110\u01B0\u1EDDng
      l\xEAn \u0111\xE2y xa th\u1EADt."
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: 2984b2f022ec49c4d9d75922f086b35a, type: 3}
  - speakerName: Minh Khoa
    text: "Bi\u1EC7t th\u1EF1 \u0110\u1ED7 Gia... x\xE2y n\u0103m 1940. Ki\u1EBFn
      tr\xFAc s\u01B0 ng\u01B0\u1EDDi Ph\xE1p c\xF9ng \xF4ng \u0110\u1ED7 V\u0103n
      Minh d\u1EF1ng n\xEAn c\u0103n bi\u1EC7t th\u1EF1 bi\u1EC7t l\u1EADp n\xE0y."
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: 84961baadebdacf4db82d343d0330876, type: 3}
  - speakerName: Minh Khoa
    text: "\u0110\u1EC1 t\xE0i t\u1ED1t nghi\u1EC7p c\u1EE7a m\xECnh \u0111\xFAng
      l\xE0 kh\xF4ng th\u1EC3 thi\u1EBFu ch\u1ED7 n\xE0y."
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: 39f9b003547affd44bbfe72cb9fd0f8e, type: 3}
  - speakerName: Minh Khoa
    text: "Ch\u1EE5p v\xE0i t\u1EA5m, ph\xE1c m\u1EB7t ti\u1EC1n r\u1ED3i v\u1EC1
      th\xF4i. M\xECnh kh\xF4ng d\xE1m \u1EDF \u0111\xE2y l\xE2u \u0111\xE2u."
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: 2745f8950d083d94da1d2013f446c5cd, type: 3}
