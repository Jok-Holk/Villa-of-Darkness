--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff4459042ab88464388416038b51768c, type: 3}
  m_Name: DialogueAsset_Ch1_MK_Hide
  m_EditorClassIdentifier: BietThuBongToi.Runtime::DialogueAsset
  lines:
  - speakerName: Minh Khoa
    text: "C\xE1i g\xEC v\u1EEBa...\n"
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: 513e5485ecd6a8a44a06b6dde5977f02, type: 3}
  - speakerName: Minh Khoa
    text: "\u0110\u1EEBng th\u1EA5y m\xECnh, \u0111\u1EEBng th\u1EA5y m\xECnh...\n"
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: 12f8ace4cebff4043ba2b9de5f92eea5, type: 3}
  - speakerName: Minh Khoa
    text: "\u1ED4n r\u1ED3i, h\xECnh nh\u01B0 l\xE0 \u1ED5n r\u1ED3i."
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: 60e86b3b1e309b94b918b89bdacfc9cf, type: 3}
  - speakerName: Minh Khoa
    text: "M\xECnh v\u1EEBa nghe th\u1EA5y g\xEC v\u1EADy? Kh\xF4ng, kh\xF4ng, \u0111\u1EEBng
      ngh\u0129 t\u1EDBi n\xF3 n\u1EEFa. C\u1EE9 \u1EDF \u0111\xE2y th\xEAm ch\xFAt
      \u0111\xE3, ch\xE2n m\xECnh c\xF2n rung qu\xE1."
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: fc75979be032af541b9b104113d03ee1, type: 3}
  - speakerName: Minh Khoa
    text: "N\xF3 g\u1ECDi \u0111\xFAng t\xEAn m\xECnh, r\u1ED3i n\xF3 h\xE1t \u0111\xFAng
      c\xE1i \u0111i\u1EC7u ban n\xE3y, r\u1ED3i n\xF3 g\u1ECDi t\xEAn Linh, Minh."
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: 03432658b165742428fe9d6c85414a64, type: 3}
  - speakerName: Minh Khoa
    text: "N\xF3 g\u1ECDi \u0111\xFAng t\xEAn m\xECnh, r\u1ED3i n\xF3 h\xE1t \u0111\xFAng
      c\xE1i \u0111i\u1EC7u ban n\xE3y, r\u1ED3i n\xF3 g\u1ECDi t\xEAn Linh, Minh."
    hasVoice: 1
    voiceClip: {fileID: 8300000, guid: dcf6e17dc16ea184eb47526cb7f2741e, type: 3}
