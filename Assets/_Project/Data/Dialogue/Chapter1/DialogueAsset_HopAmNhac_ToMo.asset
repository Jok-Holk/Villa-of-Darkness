  lines:
  - speakerName: Khoa
    text: "M\u1ED9t h\u1ED9p nh\u1EA1c b\u1EB1ng \u0111\u1ED3ng, \u0111\u1EB7t ngay
      ng\u1EAFn gi\u1EEFa l\u1EDBp b\u1EE5i -- nh\u01B0 th\u1EC3 m\u1EDBi c\xF3 ai
      \u0111\xF3 lau qua n\xF3 ch\u01B0a l\xE2u."
    hasVoice: 0
    voiceClip: {fileID: 0}
  - speakerName: Khoa
    text: "B\xEAn trong n\xE0y l\xE0 g\xEC nh\u1EC9? Th\u1EED l\xEAn d\xE2y xem sao."
    hasVoice: 0
    voiceClip: {fileID: 0}
