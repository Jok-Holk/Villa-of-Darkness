  m_Script: {fileID: 0}
  m_Name: New Dialogue Asset
  m_EditorClassIdentifier: BietThuBongToi.Runtime::DialogueAsset
  lines:
  - speakerName: Minh Khoa
    text: "Bi\u1EC7t th\u1EF1 \u0110\u1ED7 Gia. Nghe n\xF3i c\u1EA3 nh\xE0 m\u1EA5t
      t\xEDch h\u1ED3i ba l\u0103m n\u0103m tr\u01B0\u1EDBc, kh\xF4ng \u0111\u1EC3
      l\u1EA1i d\u1EA5u v\u1EBFt g\xEC."
    choices: []
  - speakerName: Minh Khoa
    text: "Ch\u1EC9 c\u1EA7n v\xE0i t\u1EA5m \u1EA3nh cho \u0111\u1EC1 t\xE0i t\u1ED1t
      nghi\u1EC7p th\xF4i. V\xE0o r\u1ED3i ra ngay."
    choices: []
  - speakerName: Minh Khoa
    text: "(Th\u1EED n\u1EAFm c\u1EEDa) ... Kho\xE1. Ch\u1EAFc ch\u1EAFn kho\xE1
      r\u1ED3i."
    choices: []
  - speakerName: Minh Khoa
    text: "Kh\xF4ng t\xECm \u0111\u01B0\u1EE3c ch\xECa \u0111\xE2u c\u1EA3. Ch\u1EAFc
      ph\u1EA3i t\xECm l\u1ED1i kh\xE1c v\xE0o."
    choices: []
